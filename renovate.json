{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pyenv": {"enabled": false},
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/netclab/lab\\.py$/", "/^templates/.+\\.yaml$/"],
      "matchStrings": [
        "REGISTRY_IMAGE = \"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\"",
        "\\$\\w+DefaultImg := \"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\"",
        "image: (?<depName>[^\\s:{]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/netclab/lab\\.py$/"],
      "matchStrings": ["CNI_PLUGINS = \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "containernetworking/plugins"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/netclab/lab\\.py$/"],
      "matchStrings": ["MULTUS = \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k8snetworkplumbingwg/multus-cni"
    }
  ]
}
